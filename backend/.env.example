# ============================================================================
# AI Heat Safety Assistant — environment configuration
# Copy this file to `.env` and fill in the values. NEVER commit `.env`.
# ============================================================================

# --- Application -------------------------------------------------------------
APP_NAME=AI Heat Safety Assistant
APP_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- CORS --------------------------------------------------------------------
# Comma-separated list of allowed frontend origins (no spaces required).
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# ============================================================================
# FortyGuard tOS / Temperature API  (https://api.fortyguard.com)
# ----------------------------------------------------------------------------
# Contract verified against the official quickstart client
# (github.com/FortyGuard-Tech/temperature-api-quickstart):
#   * host:  https://api.fortyguard.com
#   * auth:  custom header  `api-key: <key>`   (NOT `Authorization: Bearer`)
#   * async heatmap workflow:
#        submit  POST /v1/heatmap            -> data.activity_id
#        poll    GET  /v1/status/{activity_id}
#
# NOTE: FortyGuard coverage is U.S. ONLY. Use a U.S. location for live testing
# (preferred: San Jose, California — lat 37.3382, lon -121.8863).
#
# The heatmap endpoints need ONLY FORTYGUARD_API_KEY + FORTYGUARD_BASE_URL.
# ============================================================================

# Your FortyGuard API key (secret — keep it only in .env, never commit it).
FORTYGUARD_API_KEY=

# API host. The verified public host is https://api.fortyguard.com
# (no trailing slash needed).
FORTYGUARD_BASE_URL=https://api.fortyguard.com

# --- Async heatmap polling (submit -> poll) ---------------------------------
# The POST /api/v1/heatmap request waits up to FORTYGUARD_MAX_WAIT_SECONDS for
# the job to finish (polling every FORTYGUARD_POLL_INTERVAL_SECONDS); if it is
# still processing it returns 202 + an activity_id to fetch later.
FORTYGUARD_POLL_INTERVAL_SECONDS=3
FORTYGUARD_MAX_WAIT_SECONDS=25

# --- Legacy point-temperature endpoint (optional) ---------------------------
# The real API has no single-point temperature lookup, so /api/v1/temperature
# and /api/v1/heat-risk stay HTTP 503 unless you point them at a compatible
# endpoint. Leave these unset for the heatmap integration.
FORTYGUARD_TEMPERATURE_PATH=
# How the key is sent for that legacy call. Defaults match the verified
# contract: a raw `api-key` header with no scheme prefix.
FORTYGUARD_AUTH_HEADER=api-key
FORTYGUARD_AUTH_SCHEME=
FORTYGUARD_HTTP_METHOD=GET
FORTYGUARD_REQUEST_STYLE=query
FORTYGUARD_LOCATION_PARAM=location
FORTYGUARD_LAT_PARAM=lat
FORTYGUARD_LON_PARAM=lon

# Request timeout in seconds (per HTTP call).
FORTYGUARD_TIMEOUT_SECONDS=10

# ============================================================================
# AI provider (OPTIONAL)
# ----------------------------------------------------------------------------
# If unset, the AI endpoints return deterministic, data-grounded guidance
# (generated_by="rule_based"). If set, an OpenAI-compatible chat-completions
# endpoint is used (generated_by="llm"), with automatic fallback on failure.
# ============================================================================

# Secret API key for your AI provider.
AI_API_KEY=

# Base URL such that <AI_BASE_URL>/chat/completions is valid,
# e.g. https://api.openai.com/v1
AI_BASE_URL=

# Model identifier, e.g. gpt-4o-mini
AI_MODEL=

# AI request timeout in seconds.
AI_TIMEOUT_SECONDS=30
