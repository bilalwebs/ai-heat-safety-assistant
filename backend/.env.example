# ============================================================================
# AI Heat Safety Assistant — environment configuration
# Copy this file to `.env` and fill in the values. NEVER commit `.env`.
# ============================================================================

# --- Application -------------------------------------------------------------
APP_NAME=AI Heat Safety Assistant
APP_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- CORS --------------------------------------------------------------------
# Comma-separated list of allowed frontend origins (no spaces required).
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# ============================================================================
# FortyGuard Temperature API  (https://docs-api.fortyguard.com)
# ----------------------------------------------------------------------------
# These describe the REAL FortyGuard contract as configuration so nothing is
# hard-coded or guessed. Obtain the exact values from the FortyGuard docs /
# your account dashboard, then fill them in.
#
# The temperature and heat-risk endpoints return HTTP 503 until FORTYGUARD_API_KEY,
# FORTYGUARD_BASE_URL and FORTYGUARD_TEMPERATURE_PATH are all set.
# ============================================================================

# Your FortyGuard API key (secret — keep it only in .env).
FORTYGUARD_API_KEY=

# API host, e.g. https://api.fortyguard.com  (no trailing slash needed).
FORTYGUARD_BASE_URL=

# The exact temperature endpoint path from the FortyGuard docs, e.g. /v1/temperature.
FORTYGUARD_TEMPERATURE_PATH=

# How the API key is sent. Defaults assume `Authorization: Bearer <key>`.
# For a raw key header (e.g. `x-api-key: <key>`), set:
#   FORTYGUARD_AUTH_HEADER=x-api-key
#   FORTYGUARD_AUTH_SCHEME=            (leave empty — no scheme prefix)
FORTYGUARD_AUTH_HEADER=Authorization
FORTYGUARD_AUTH_SCHEME=Bearer

# HTTP method and request style. Use GET+query or POST+json per the real API.
FORTYGUARD_HTTP_METHOD=GET
FORTYGUARD_REQUEST_STYLE=query

# Outgoing parameter names the API expects for location inputs.
FORTYGUARD_LOCATION_PARAM=location
FORTYGUARD_LAT_PARAM=lat
FORTYGUARD_LON_PARAM=lon

# Request timeout in seconds.
FORTYGUARD_TIMEOUT_SECONDS=10

# ============================================================================
# AI provider (OPTIONAL)
# ----------------------------------------------------------------------------
# If unset, the AI endpoints return deterministic, data-grounded guidance
# (generated_by="rule_based"). If set, an OpenAI-compatible chat-completions
# endpoint is used (generated_by="llm"), with automatic fallback on failure.
# ============================================================================

# Secret API key for your AI provider.
AI_API_KEY=

# Base URL such that <AI_BASE_URL>/chat/completions is valid,
# e.g. https://api.openai.com/v1
AI_BASE_URL=

# Model identifier, e.g. gpt-4o-mini
AI_MODEL=

# AI request timeout in seconds.
AI_TIMEOUT_SECONDS=30
